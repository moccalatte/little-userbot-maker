# Userbot Configuration
# Copy this file to .env and fill in the values

# Database Configuration - Neon PostgreSQL (REQUIRED)
# Get this from your Neon dashboard: https://neon.tech
DATABASE_URL=postgresql://neondb_owner:npg_9RjYElDSJd1L@ep-muddy-cloud-a1k2smnz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Telegram API credentials (from my.telegram.org)
# These can be shared across all userbots or user-specific
API_ID=13311218
API_HASH=f24f2481bc05f704033308eae0dd9bc2

# Session file path (if using file-based session)
SESSION_FILE=./session.session

# Database session (alternative to SESSION_FILE)
# If set, userbot will load session from database instead of file
SESSION_OWNER_ID=

# Secret Key for decrypting database sessions
# Must be same as the one used in bot wizard
SECRET_KEY=

# Admin/Owner Configuration (comma-separated user IDs)
# These users have full admin access without restrictions
OWNER_IDS=5473468582
ADMIN_IDS=

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Data storage
DATA_DIR=./data

# Optional: Forward important logs to Telegram chat
TELEGRAM_LOG_CHAT_ID=

# Rate limiting (seconds between command executions)
RATE_LIMIT_INTERVAL=30
