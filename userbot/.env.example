# Userbot Configuration
# Copy this file to .env and fill in the values

# Telegram API credentials (from my.telegram.org)
API_ID=
API_HASH=

# Session file path (if using file-based session)
SESSION_FILE=../session.session

# Database session (alternative to SESSION_FILE)
# If set, userbot will load session from database instead of file
SESSION_OWNER_ID=

# Secret Key for decrypting database sessions
# Must be same as the one used in bot wizard
SECRET_KEY=

# Logging
LOG_LEVEL=INFO
LOG_DIR=../logs

# Data storage
DATA_DIR=../data

# Optional: Forward important logs to Telegram chat
TELEGRAM_LOG_CHAT_ID=

# Rate limiting (seconds between command executions)
RATE_LIMIT_INTERVAL=30