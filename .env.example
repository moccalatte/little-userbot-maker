# Konfigurasi umum
PYTHON_VERSION=3.11
LOG_LEVEL=INFO
LOG_DIR=./logs
DATA_DIR=./data
TELEGRAM_LOG_CHAT_ID=
RATE_LIMIT_INTERVAL=30
QR_TIMEOUT=180

# Bot wizard UserbotMaker
TELEGRAM_BOT_TOKEN=
SECRET_KEY=
SESSION_OUTPUT_FILE=./session.session

# Session generator terpisah
SESSIONGEN_BOT_TOKEN=

# Userbot Telethon (gunakan API ID/hash milik operator userbot, bukan milik pengguna wizard)
API_ID=
API_HASH=
SESSION_FILE=./session.session

# Opsional: isi SESSION_OWNER_ID dengan Telegram user ID yang membuat session via wizard.
# Jika diisi, userbot akan memuat session terbaru dari database dan SESSION_FILE tidak digunakan.
# SECRET_KEY harus terisi untuk mendekripsi session terenkripsi.
SESSION_OWNER_ID=
