# Bot Wizard Configuration
# Copy this file to .env and fill in the values

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Secret Key for encrypting sessions (32 chars recommended)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Logging
LOG_LEVEL=INFO
LOG_DIR=../logs

# Data storage
DATA_DIR=../data

# Session handling
SESSION_OUTPUT_FILE=./session.session
QR_TIMEOUT=180

# Optional: Forward important logs to Telegram chat
TELEGRAM_LOG_CHAT_ID=

# Rate limiting
RATE_LIMIT_INTERVAL=30